#!/usr/bin/env python3
"""Slothmore CLI: start the local dashboard, or print the version."""
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

# Make relative static paths and any leftover cwd assumptions resolve to the app root.
os.chdir(str(ROOT))

import server  # noqa: E402

if __name__ == "__main__":
    server.main()
